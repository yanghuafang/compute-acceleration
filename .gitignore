# Build trees. scripts/build-accel.sh configures out of tree, into a sibling of the
# checkout (../compute-acceleration-build/<name>), so nothing it produces can land
# here. These patterns stay as a guard against a hand-run `cmake -B build` and
# against IDEs that insist on an in-tree build directory.
build/
cmake-build-*/

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS for clangd and clang-tidy.
compile_commands.json
.cache/

# NVCC intermediates, emitted when nvcc is invoked by hand.
*.i
*.ii
*.gpu
*.ptx
*.cubin
*.fatbin

# Host build leftovers from a manual g++/clang++ invocation.
*.o
*.a
*.dSYM/

# Profiler and sanitizer output.
*.nsys-rep
*.qdrep
*.sqlite
sanitizer-*.log

# Doxygen output. scripts/docs.sh writes it beside the build tree, so this only
# catches a `doxygen` run launched by hand from the repo root.
html/
latex/
doxygen-warnings.log

# Editor and OS noise.
.DS_Store
._*
.idea/
*~
*.swp
*.swo
